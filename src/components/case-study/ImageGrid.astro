---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface GridImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GridImage[];
  dark?: boolean;
  cols?: 2 | 3;
}

const { images, dark = false, cols = 2 } = Astro.props;
const colsClass = cols === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<div class:list={['full-bleed py-8 sm:py-12', dark && 'bg-ink']}>
  <div class:list={['mx-auto grid max-w-6xl grid-cols-1 gap-4 px-6', colsClass]}>
    {
      images.map((img) => (
        <Image
          src={img.src}
          alt={img.alt}
          width={900}
          height={900}
          quality={100}
          loading="lazy"
          class="aspect-square w-full rounded-2xl object-cover"
        />
      ))
    }
  </div>
</div>
