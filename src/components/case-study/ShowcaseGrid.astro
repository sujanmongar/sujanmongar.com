---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface GridItem {
  src: ImageMetadata;
  alt: string;
  span?: 1 | 2;
}

interface Props {
  items: GridItem[];
  dark?: boolean;
}

const { items, dark = false } = Astro.props;
---

<div class="full-bleed my-8 px-4 sm:px-6">
  <div class:list={['rounded-3xl p-8 sm:p-14', dark ? 'showcase-dark' : 'showcase-grey']}>
    <div class="grid grid-cols-1 items-start gap-8 sm:grid-cols-2 sm:gap-14">
      {
        items.map((item) => (
          <div class:list={[item.span === 2 && 'sm:col-span-2']}>
            <Image
              src={item.src}
              alt={item.alt}
              width={1200}
              quality={100}
              loading="lazy"
              class="h-auto w-full rounded-xl"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>
