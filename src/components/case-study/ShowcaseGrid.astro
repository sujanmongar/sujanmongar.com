---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

type Panel = 'dark' | 'light' | 'mist';

interface GridItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  items: GridItem[];
  panel?: Panel;
}

const { items, panel = 'dark' } = Astro.props;

const panelClass: Record<Panel, string> = {
  dark: 'showcase-dark',
  light: 'showcase-grey',
  mist: 'showcase-mist'
};
---

<div class="full-bleed my-[20px] px-4 sm:px-8">
  <div class:list={['showcase-panel overflow-hidden rounded-lg', panelClass[panel]]}>
    <div class="showcase-masonry [&>*:last-child]:mb-0">
      {
        items.map((item) => (
          <Image
            src={item.src}
            alt={item.alt}
            width={1600}
            quality={92}
            loading="lazy"
            class="h-auto w-full"
          />
        ))
      }
    </div>
  </div>
</div>
