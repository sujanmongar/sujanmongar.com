---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface GridItem {
  src: ImageMetadata;
  alt: string;
  span?: 1 | 2;
}

interface Props {
  items: GridItem[];
  dark?: boolean;
  logo?: ImageMetadata;
  logoAlt?: string;
}

const { items, dark = false, logo, logoAlt } = Astro.props;
---

<div class="full-bleed my-8 px-4 sm:px-6">
  <div class:list={['rounded-3xl p-6 sm:p-14', dark ? 'showcase-dark' : 'showcase-grey']}>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
      {
        items.map((item) => (
          <div class:list={[item.span === 2 && 'sm:col-span-2']}>
            <Image
              src={item.src}
              alt={item.alt}
              width={1200}
              quality={100}
              loading="lazy"
              class="h-auto w-full rounded-xl"
            />
          </div>
        ))
      }
    </div>
    {
      logo && (
        <div class="mt-10 sm:mt-14">
          <Image
            src={logo}
            alt={logoAlt ?? ''}
            width={360}
            quality={100}
            class="mx-auto h-auto w-full max-w-[220px]"
          />
        </div>
      )
    }
  </div>
</div>
