---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface GridItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  items: GridItem[];
  panel?: 'dark' | 'light';
  logo?: ImageMetadata;
  logoAlt?: string;
}

const { items, panel = 'dark', logo, logoAlt } = Astro.props;
const panelClass = panel === 'dark' ? 'showcase-dark' : 'showcase-grey';
---

<div class="full-bleed my-6 px-4 sm:px-8">
  <div class:list={['overflow-hidden rounded-lg', panelClass]}>
    <div class="showcase-masonry">
      {
        items.map((item) => (
          <Image
            src={item.src}
            alt={item.alt}
            width={1600}
            quality={92}
            loading="lazy"
            class="h-auto w-full"
          />
        ))
      }
    </div>
    {
      logo && (
        <Image
          src={logo}
          alt={logoAlt ?? ''}
          width={1600}
          quality={92}
          loading="lazy"
          class="h-auto w-full"
        />
      )
    }
  </div>
</div>
