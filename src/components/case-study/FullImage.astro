---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  dark?: boolean;
}

const { src, alt, dark = false } = Astro.props;
---

<div class:list={['full-bleed py-8 sm:py-12', dark && 'bg-ink']}>
  <Image
    src={src}
    alt={alt}
    width={2400}
    height={1500}
    quality={100}
    loading="lazy"
    class="mx-auto w-full max-w-6xl object-contain"
  />
</div>
