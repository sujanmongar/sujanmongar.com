---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Panel = 'dark' | 'dark-v' | 'dark-d' | 'light' | 'mist' | 'plain';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Gradient panel behind the image; 'plain' sits on the page background */
  panel?: Panel;
  /** Load first, at high priority: set on the first image of a case study */
  priority?: boolean;
}

const { src, alt, panel = 'plain', priority = false } = Astro.props;

const panelClass: Record<Panel, string> = {
  dark: 'showcase-dark',
  'dark-v': 'showcase-dark-v',
  'dark-d': 'showcase-dark-d',
  light: 'showcase-grey',
  mist: 'showcase-mist',
  plain: ''
};
---

<div class="full-bleed my-[20px] px-4 sm:px-8" data-reveal>
  <div class:list={['overflow-hidden rounded-lg', panelClass[panel]]}>
    <Picture
      src={src}
      alt={alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 828, 1080, 1280, 1600, 1920, 2400, 2800]}
      sizes="(min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)"
      priority={priority}
      pictureAttributes={{ class: 'contents' }}
      class="h-auto w-full"
    />
  </div>
</div>
