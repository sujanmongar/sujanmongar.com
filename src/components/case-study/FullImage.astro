---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

type Panel = 'dark' | 'dark-v' | 'dark-d' | 'light' | 'mist' | 'plain';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Gradient panel behind the image; 'plain' sits on the page background */
  panel?: Panel;
}

const { src, alt, panel = 'plain' } = Astro.props;

const panelClass: Record<Panel, string> = {
  dark: 'showcase-dark',
  'dark-v': 'showcase-dark-v',
  'dark-d': 'showcase-dark-d',
  light: 'showcase-grey',
  mist: 'showcase-mist',
  plain: ''
};
---

<div class="full-bleed my-[20px] px-4 sm:px-8">
  <div class:list={['overflow-hidden rounded-lg', panelClass[panel]]}>
    <Image src={src} alt={alt} width={2800} quality={92} loading="lazy" class="h-auto w-full" />
  </div>
</div>
