---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-10 -mx-6 sm:mx-0">
  <Image
    src={src}
    alt={alt}
    width={1400}
    height={900}
    loading="lazy"
    class="w-full rounded-none sm:rounded-2xl border-y sm:border border-line/70 object-cover"
  />
  {caption && <figcaption class="mt-3 text-center text-sm text-ink-soft">{caption}</figcaption>}
</figure>
