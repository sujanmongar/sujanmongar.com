---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  text?: string;
  logo?: ImageMetadata;
  logoAlt?: string;
  dark?: boolean;
}

const { text, logo, logoAlt, dark = true } = Astro.props;
---

<div class="full-bleed my-8 px-4 sm:px-6">
  <div
    class:list={['overflow-hidden rounded-3xl', dark ? 'showcase-dark' : 'showcase-grey']}
  >
    {
      logo ? (
        <Image src={logo} alt={logoAlt ?? ''} width={2400} quality={100} class="h-auto w-full" />
      ) : (
        <p
          class:list={[
            'font-display py-20 text-center text-5xl font-medium italic sm:py-28 sm:text-7xl',
            dark ? 'text-paper' : 'text-ink'
          ]}
        >
          {text}
        </p>
      )
    }
  </div>
</div>
