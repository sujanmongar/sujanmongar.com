---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="my-10 grid grid-cols-2 gap-6 rounded-2xl bg-paper-dim p-6 sm:grid-cols-3">
  {
    stats.map((stat) => (
      <div>
        <p class="text-2xl font-extrabold sm:text-3xl">{stat.value}</p>
        <p class="mt-1 text-sm text-ink-soft">{stat.label}</p>
      </div>
    ))
  }
</div>
