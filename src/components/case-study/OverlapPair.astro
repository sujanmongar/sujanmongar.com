---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  left: ImageMetadata;
  leftAlt: string;
  right: ImageMetadata;
  rightAlt: string;
}

const { left, leftAlt, right, rightAlt } = Astro.props;
---

{/* Two oversized renders that overlap on desktop and stack on mobile, as on the original */}
<div class="full-bleed my-6 px-4 sm:px-8">
  <div class="relative flex flex-col gap-4 md:block md:h-0 md:gap-0 md:pb-[56%]">
    <Image
      src={left}
      alt={leftAlt}
      width={2000}
      quality={92}
      loading="lazy"
      class="h-auto w-full md:absolute md:top-0 md:left-0 md:w-[72%]"
    />
    <Image
      src={right}
      alt={rightAlt}
      width={2000}
      quality={92}
      loading="lazy"
      class="h-auto w-full md:absolute md:right-0 md:bottom-0 md:w-[72%]"
    />
  </div>
</div>
