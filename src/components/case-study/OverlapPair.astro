---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  left: ImageMetadata;
  leftAlt: string;
  right: ImageMetadata;
  rightAlt: string;
}

const { left, leftAlt, right, rightAlt } = Astro.props;
---

{/* Two oversized renders that overlap on desktop and stack on mobile, as on the original */}
<div class="full-bleed my-[20px] px-4 sm:px-8" data-reveal>
  <div class="relative flex flex-col gap-4 md:block md:h-0 md:gap-0 md:pb-[56%]">
    <Picture
      src={left}
      alt={leftAlt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 828, 1080, 1280, 1600, 2000, 2600]}
      sizes="(min-width: 768px) calc(72vw - 46px), (min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)"
      pictureAttributes={{ class: 'contents' }}
      class="h-auto w-full md:absolute md:top-0 md:left-0 md:w-[72%]"
    />
    <Picture
      src={right}
      alt={rightAlt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 828, 1080, 1280, 1600, 2000, 2600]}
      sizes="(min-width: 768px) calc(72vw - 46px), (min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)"
      pictureAttributes={{ class: 'contents' }}
      class="h-auto w-full md:absolute md:right-0 md:bottom-0 md:w-[72%]"
    />
  </div>
</div>
