---
// A small circular affordance used wherever a card or row links onward.
// Expects to sit inside an element carrying the `group` class — it reacts
// to that ancestor's hover, not its own.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-ink/15 text-base transition-all duration-300 group-hover:-rotate-[60deg] group-hover:border-accent group-hover:text-accent sm:size-11',
    className
  ]}
>
  →
</span>
