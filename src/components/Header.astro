---
const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' }
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between py-4">
    <a
      href="/"
      class="font-display text-xl font-semibold tracking-[0.06em] uppercase transition-colors hover:text-accent"
    >
      Sujan<span class="text-accent">.</span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium sm:gap-8">
      {
        navItems.map((item) => {
          const active = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'transition-colors hover:text-accent',
                active ? 'text-ink' : 'text-ink-soft'
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
