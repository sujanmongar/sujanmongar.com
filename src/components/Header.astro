---
const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' }
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between py-4">
    <a href="/" class="text-sm font-bold tracking-[0.22em] uppercase">SUJAN</a>
    <nav class="flex items-center gap-3 text-sm font-medium sm:gap-6">
      <div class="hidden items-center gap-6 sm:flex">
        {
          navItems.map((item) => {
            const active =
              item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-accent',
                  active ? 'text-ink' : 'text-ink-soft'
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>
      <a
        href="/#get-in-touch"
        class="rounded-full bg-ink px-4 py-2 text-xs font-semibold text-paper transition-colors hover:bg-accent"
      >
        Get in touch
      </a>
    </nav>
  </div>
  <nav class="wrap flex items-center gap-5 border-t border-line/70 py-2.5 text-sm font-medium sm:hidden">
    {
      navItems.map((item) => {
        const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a href={item.href} class:list={['transition-colors', active ? 'text-ink' : 'text-ink-soft']}>
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>
