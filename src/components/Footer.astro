---
// Email is intentionally absent — the form below replaces it
const links = [
  { href: 'https://www.linkedin.com/in/sujanmongar/', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://wa.me/61451716040', label: 'WhatsApp', icon: 'whatsapp' }
] as const;

const icons = {
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413'
};
const year = new Date().getFullYear();

// Web3Forms access keys are public by design — they ship in the client bundle
// and only allow submitting this form. Override via PUBLIC_WEB3FORMS_KEY if needed.
const accessKey =
  import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '2645fe17-70af-4457-95a1-257378f53880';
---

<footer id="get-in-touch" class="bg-paper-dim">
  <div class="wrap pt-16 sm:pt-20" data-reveal>
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase">Get in Touch</p>
        <h2 class="font-display mt-5 text-[clamp(2rem,3.6vw,3.25rem)] leading-[1.08] font-medium">
          Let's create something meaningful together.
        </h2>
        <p class="measure mt-5 text-ink-soft">
          Have a product idea or need to improve your user experience? Let's discuss how we can
          build something clear, scalable, and impactful.
        </p>
        <p class="font-display mt-6 text-xl italic text-ink-soft">
          Designing with purpose, <span class="text-accent not-italic">building with care.</span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
              >
                <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
                  <path d={icons[link.icon]} />
                </svg>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <form id="contact-form" class="flex flex-col gap-5" novalidate data-key={accessKey}>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-xs font-semibold tracking-[0.1em] text-ink-soft uppercase">
              Name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Your name"
              class="mt-2 w-full rounded-lg border border-ink/15 bg-paper px-4 py-3 text-base text-ink placeholder:text-ink-soft/60 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
            />
            <p data-error-for="name" class="mt-2 hidden text-sm text-danger"></p>
          </div>
          <div>
            <label for="email" class="text-xs font-semibold tracking-[0.1em] text-ink-soft uppercase">
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@studio.com"
              class="mt-2 w-full rounded-lg border border-ink/15 bg-paper px-4 py-3 text-base text-ink placeholder:text-ink-soft/60 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
            />
            <p data-error-for="email" class="mt-2 hidden text-sm text-danger"></p>
          </div>
        </div>
        <div>
          <label for="message" class="text-xs font-semibold tracking-[0.1em] text-ink-soft uppercase">
            Project
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="4"
            placeholder="What are you building, and when do you need it?"
            class="mt-2 w-full resize-none rounded-lg border border-ink/15 bg-paper px-4 py-3 text-base text-ink placeholder:text-ink-soft/60 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
          ></textarea>
          <p data-error-for="message" class="mt-2 hidden text-sm text-danger"></p>
        </div>

        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <p id="contact-status" class="text-sm text-ink-soft" role="status" aria-live="polite">
            No newsletters. Just a reply.
          </p>
          <button
            type="submit"
            class="shrink-0 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent disabled:opacity-60"
          >
            Send note
          </button>
        </div>
      </form>
    </div>

    <div class="mt-16 flex flex-col justify-between gap-2 border-t border-line/70 py-6 text-xs text-ink-soft sm:flex-row sm:py-8">
      <p>© {year} Sujan Mongar. All rights reserved.</p>
      <p>Thimphu, Bhutan</p>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const accessKey = document.getElementById('contact-form')?.dataset.key ?? '';

  const showError = (field: string, message: string) => {
    const el = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    const input = form?.querySelector<HTMLElement>(`#${field}`);
    if (el) {
      el.textContent = message;
      el.classList.toggle('hidden', !message);
    }
    input?.classList.toggle('border-danger', Boolean(message));
    input?.classList.toggle('focus:ring-danger', Boolean(message));
    input?.setAttribute('aria-invalid', message ? 'true' : 'false');
  };

  const validate = () => {
    if (!form) return false;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    showError('name', name ? '' : 'Please enter your name.');
    showError('email', !email
      ? 'Please enter your email.'
      : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
        ? ''
        : 'Please enter a valid email address.');
    showError('message', message ? '' : 'Please tell me a little about the project.');

    const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
    if (firstInvalid) {
      firstInvalid.focus();
      return false;
    }
    return true;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) status.textContent = 'No newsletters. Just a reply.';
    if (!validate()) return;

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    if (!accessKey) {
      if (status) status.textContent = 'The form is not connected yet — please use LinkedIn or WhatsApp.';
      return;
    }

    if (button) button.disabled = true;
    if (status) status.textContent = 'Sending…';

    const data = new FormData(form);
    data.append('access_key', accessKey);
    data.append('subject', `New message from ${data.get('name')} via sujanmongar.com`);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data
      });
      const result = await res.json();
      if (!result.success) throw new Error(result.message || 'Submission failed');
      form.reset();
      if (status) status.textContent = "Sent — I'll reply soon. Thank you!";
    } catch {
      if (status) status.textContent = 'Something went wrong — please try LinkedIn or WhatsApp.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
