---
const steps = [
  { n: '01', title: 'Understand', body: 'A short call to learn the product, the users, and what "done" looks like.' },
  { n: '02', title: 'Explore', body: 'Research, audits and quick wireframes to find the right structure first.' },
  { n: '03', title: 'Design', body: 'High-fidelity UI built as a system — components and states, not one screen.' },
  { n: '04', title: 'Hand off', body: 'Clean Figma files, specs and prototypes your team can build from.' }
];
---

<section class="section border-t border-line/70">
  <div class="wrap">
    <h2 class="font-display text-3xl font-medium sm:text-4xl">How I work</h2>

    <ol class="mt-12 grid grid-cols-1 gap-10 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        steps.map((step) => (
          <li>
            <span class="font-mono text-xs text-accent">{step.n}</span>
            <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
