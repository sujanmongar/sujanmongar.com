---
const steps = [
  { n: '01', title: 'Understand', body: 'A short call to learn the product, the users, and what "done" looks like.' },
  { n: '02', title: 'Explore', body: 'Research, audits and quick wireframes to find the right structure first.' },
  { n: '03', title: 'Design', body: 'High-fidelity UI built as a system — components and states, not one screen.' },
  { n: '04', title: 'Hand off', body: 'Clean Figma files, specs and prototypes your team can build from.' }
];
---

{/* Dark band: gives the page contrast and echoes the case study panels */}
<section class="showcase-dark">
  <div class="wrap section">
    <h2 class="font-display text-3xl font-medium text-paper sm:text-4xl">How I work</h2>
    <p class="measure mt-5 text-lg leading-relaxed text-paper/60">
      A short path from an unclear problem to design your team can build.
    </p>

    <ol class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li>
            <span class="font-mono text-xs text-accent">{step.n}</span>
            <h3 class="mt-4 text-xl font-semibold text-paper">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-paper/60">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
