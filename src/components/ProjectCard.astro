---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  index: number;
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const { title, summary, cover, coverAlt, role, timeline } = project.data;

// Alternating tone, reusing the case study panel gradients so the whole
// site speaks one language.
const panel = index % 2 === 0 ? 'showcase-dark' : 'showcase-grey';
---

<a href={`/work/${project.id}/`} class="group block">
  {/* One large frame — the work itself is the whole card */}
  <div class="wrap">
    <div class:list={['overflow-hidden rounded-2xl p-6 sm:p-10', panel]}>
      <Image
        src={cover}
        alt={coverAlt}
        width={2000}
        quality={92}
        loading={priority ? 'eager' : 'lazy'}
        class="mx-auto h-auto w-full max-w-4xl transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      />
    </div>
  </div>

  {/* Title and meta read underneath, like a caption */}
  <div class="wrap mt-8 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h3
        class="font-display text-[clamp(1.75rem,3.6vw,2.75rem)] leading-tight font-medium tracking-[-0.01em] transition-colors group-hover:text-accent"
      >
        {title}
      </h3>
      <p class="measure mt-3 text-lg leading-relaxed text-ink-soft">{summary}</p>
    </div>

    <div class="flex shrink-0 items-center gap-6 sm:flex-col sm:items-end sm:gap-2 sm:text-right">
      <p class="text-sm text-ink-soft">{role} · {timeline}</p>
      <span class="inline-flex items-center gap-2 text-sm font-semibold">
        View case study
        <span
          aria-hidden="true"
          class="text-lg transition-transform duration-300 group-hover:translate-x-1.5"
        >
          →
        </span>
      </span>
    </div>
  </div>
</a>
