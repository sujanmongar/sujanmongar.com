---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArrowButton from './ArrowButton.astro';

interface Props {
  project: CollectionEntry<'work'>;
  index: number;
  priority?: boolean;
  /* 'feature' is the full-width showcase; 'compact' is a smaller grid
     entry, used once a page is carrying more than one or two projects. */
  size?: 'feature' | 'compact';
}

const { project, index, priority = false, size = 'feature' } = Astro.props;
const { title, summary, cover, coverAlt, coverTag, role, timeline } = project.data;

// Alternating tone, reusing the case study panel gradients so the whole
// site speaks one language.
const panel = index % 2 === 0 ? 'showcase-dark' : 'showcase-grey';
const tag = coverTag ?? project.data.tags[0];
---

{
  size === 'compact' ? (
    <a href={`/work/${project.id}/`} class="group block" data-reveal>
      <div class:list={['relative overflow-hidden rounded-2xl shadow-lg shadow-ink/10 transition-shadow duration-500 group-hover:shadow-2xl group-hover:shadow-ink/20', panel]}>
        {tag && (
          <span class="absolute top-4 left-4 z-10 rounded-full bg-paper/90 px-3 py-1 text-[11px] font-semibold tracking-wide text-ink backdrop-blur-sm">
            {tag}
          </span>
        )}
        {/* Aspect kept close to the artwork's own ratio, so it fills the
            frame instead of floating in a lot of dead letterbox space */}
        <div class="grid aspect-[3/2] place-items-center p-4 sm:p-5">
          <Image
            src={cover}
            alt={coverAlt}
            width={1000}
            quality={92}
            loading={priority ? 'eager' : 'lazy'}
            class="h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </div>
      </div>

      <div class="mt-5 flex items-end justify-between gap-4">
        <div>
          <h3 class="font-display text-xl font-medium transition-colors group-hover:text-accent">
            {title}
          </h3>
          <p class="mt-1.5 text-sm text-ink-soft">
            {role} · {timeline}
          </p>
        </div>
        <ArrowButton class="size-9 text-sm sm:size-9" />
      </div>
    </a>
  ) : (
    <a href={`/work/${project.id}/`} class="group block" {...(!priority ? { 'data-reveal': true } : {})}>
      {/* One large frame — the work itself is the whole card */}
      <div class="wrap">
        <div
          class:list={[
            'relative overflow-hidden rounded-[28px] px-6 py-6 shadow-xl shadow-ink/10 transition-shadow duration-500 group-hover:shadow-2xl group-hover:shadow-ink/20 sm:px-10 sm:py-8',
            panel
          ]}
        >
          {/* Read at a glance, before scrolling to the caption below */}
          {tag && (
            <span class="absolute top-6 left-6 z-10 rounded-full bg-paper/90 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-ink backdrop-blur-sm sm:top-10 sm:left-10">
              {tag}
            </span>
          )}

          <Image
            src={cover}
            alt={coverAlt}
            width={2000}
            quality={92}
            loading={priority ? 'eager' : 'lazy'}
            class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.02]"
          />
        </div>
      </div>

      {/* Title and meta read underneath, like a caption */}
      <div class="wrap mt-8 flex flex-col gap-6 sm:mt-10 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h3 class="font-display text-[clamp(1.75rem,3.6vw,2.75rem)] leading-tight font-medium tracking-[-0.01em] transition-colors group-hover:text-accent">
            {title}
          </h3>
          <p class="measure mt-3 text-lg leading-relaxed text-ink-soft">{summary}</p>
        </div>

        <div class="flex shrink-0 items-center gap-5 sm:flex-row-reverse">
          <ArrowButton />
          <p class="text-sm text-ink-soft">
            {role} · {timeline}
          </p>
        </div>
      </div>
    </a>
  )
}
