---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  index: number;
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const { title, summary, cover, coverAlt, tags, role, timeline } = project.data;

// Alternating tone and side, reusing the case study panel gradients so the
// whole site speaks one language.
const flipped = index % 2 === 1;
const panel = flipped ? 'showcase-grey' : 'showcase-dark';
const number = String(index + 1).padStart(2, '0');
---

<a href={`/work/${project.id}/`} class="group block">
  {/* Title row spans the full width so the work reads as a headline */}
  <div class="wrap flex flex-wrap items-end justify-between gap-x-10 gap-y-4 pb-8">
    <div class="flex items-baseline gap-5">
      <span class="font-mono text-sm text-accent">{number}</span>
      <h3
        class="font-display text-[clamp(1.9rem,4.4vw,3.5rem)] leading-none font-medium tracking-[-0.01em] transition-colors group-hover:text-accent"
      >
        {title}
      </h3>
    </div>
    <span class="text-sm text-ink-soft">{timeline}</span>
  </div>

  {/* Cover and details share the row, so the screen stays generous without
      taking over the whole page */}
  <div class="wrap grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center lg:gap-14">
    <div class:list={['lg:col-span-8', flipped && 'lg:order-2']}>
      <div class:list={['overflow-hidden rounded-2xl p-5 sm:p-8', panel]}>
        <Image
          src={cover}
          alt={coverAlt}
          width={1700}
          quality={92}
          loading={priority ? 'eager' : 'lazy'}
          class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.02]"
        />
      </div>
    </div>

    <div class:list={['lg:col-span-4', flipped && 'lg:order-1']}>
      <p class="text-lg leading-relaxed text-ink-soft">{summary}</p>

      <p class="mt-8 text-xs tracking-[0.14em] text-ink-soft uppercase">Role</p>
      <p class="mt-2 font-medium">{role}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          tags.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-paper-dim px-3.5 py-1.5 text-sm text-ink-soft">{tag}</li>
          ))
        }
      </ul>

      <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold">
        View case study
        <span
          aria-hidden="true"
          class="text-lg transition-transform duration-300 group-hover:translate-x-1.5"
        >
          →
        </span>
      </span>
    </div>
  </div>
</a>
