---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, summary, cover, coverAlt, tags } = project.data;
---

<a
  href={`/work/${project.id}/`}
  class="group block overflow-hidden rounded-2xl border border-line/70 bg-white transition-shadow hover:shadow-xl hover:shadow-ink/5"
>
  <div class="aspect-[4/3] overflow-hidden bg-paper-dim">
    <Image
      src={cover}
      alt={coverAlt}
      width={800}
      height={600}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold">{title}</h3>
    <p class="mt-2 text-sm text-ink-soft">{summary}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-medium text-ink-soft">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</a>
