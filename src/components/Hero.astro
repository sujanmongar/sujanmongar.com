---
/* Copy is taken verbatim from sujanmongar.com */
---

<section class="wrap pt-12 pb-[clamp(3rem,7vw,6rem)] sm:pt-16">
  <p class="hero-in hero-in-1 text-3xl" aria-hidden="true">👋</p>

  <h1 class="mt-6 sm:mt-8">
    <span
      class="hero-in hero-in-1 block text-[clamp(1rem,1.6vw,1.15rem)] font-medium tracking-[-0.01em] text-ink-soft"
    >
      Kuzu Zangpo La, I'm Sujan Mongar,
    </span>
    <span
      class="hero-in hero-in-2 font-display mt-3 block max-w-4xl text-[clamp(2.5rem,6vw,5.5rem)] leading-[1.05] font-medium tracking-[-0.02em]"
    >
      Product Designer crafting digital experiences that people <em
        class="text-accent not-italic">love to use.</em
      >
    </span>
  </h1>

  <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
    <p class="hero-in hero-in-3 text-lg leading-relaxed text-ink-soft lg:col-span-7">
      Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products
      through UX audits, research, and high-fidelity UI — available for freelance work and
      collaborations worldwide.
    </p>

    <div class="hero-in hero-in-4 flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
      <a
        href="#selected-work"
        class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-accent"
      >
        View work
      </a>
      <a
        href="#get-in-touch"
        class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>

{/* Capabilities, kept moving so the page has a pulse */}
<div class="marquee overflow-hidden border-y border-line/70 py-5">
  <div class="marquee-track">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {[
            'UX Audits',
            'User Research',
            'Usability Testing',
            'Wireframing',
            'High-fidelity UI',
            'Design Systems',
            'Prototyping'
          ].map((item) => (
            <li class="flex shrink-0 items-center gap-8 pr-8 text-lg text-ink-soft sm:text-xl">
              {item}
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
