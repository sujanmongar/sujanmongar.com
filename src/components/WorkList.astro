---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'work'>[];
}

const { projects } = Astro.props;

const rows = await Promise.all(
  projects.map(async (project, i) => {
    const optimized = await getImage({ src: project.data.cover, width: 800 });
    return { project, index: i, previewSrc: optimized.src };
  })
);
---

<div class="work-list" id="work-list">
  {
    rows.map(({ project, index, previewSrc }) => (
      <a
        href={`/work/${project.id}/`}
        class="work-row group block border-b border-line/70 py-8 transition-colors first:border-t hover:border-ink/30 sm:py-10"
        data-image={previewSrc}
      >
        {/* Mobile: cover on top, then title and tags */}
        <div class="overflow-hidden rounded-lg bg-paper-dim sm:hidden">
          <Image
            src={project.data.cover}
            alt={project.data.coverAlt}
            width={900}
            quality={92}
            loading="lazy"
            class="h-auto w-full"
          />
        </div>

        <div class="mt-5 flex items-center gap-4 sm:mt-0 sm:gap-8">
          <span class="font-mono text-xs text-ink-soft/70 sm:w-10">{`0${index + 1}`}</span>
          <h3 class="font-display flex-1 text-2xl font-semibold italic transition-colors group-hover:text-accent sm:text-4xl md:text-5xl">
            {project.data.title}
          </h3>
          <ul class="hidden shrink-0 gap-2 sm:flex sm:max-w-xs sm:flex-wrap sm:justify-end">
            {project.data.tags.slice(0, 2).map((tag) => (
              <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-medium text-ink-soft">
                {tag}
              </li>
            ))}
          </ul>
          <span
            aria-hidden="true"
            class="shrink-0 text-2xl text-ink-soft transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent"
          >
            →
          </span>
        </div>

        <ul class="mt-4 flex flex-wrap gap-2 sm:hidden">
          {project.data.tags.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-medium text-ink-soft">
              {tag}
            </li>
          ))}
        </ul>
      </a>
    ))
  }

  <div
    id="hover-preview"
    class="pointer-events-none fixed top-0 left-0 z-40 hidden w-72 overflow-hidden rounded-xl opacity-0 shadow-2xl transition-opacity duration-200 lg:block"
  >
    <img id="hover-preview-img" alt="" class="h-auto w-full" />
  </div>
</div>

<script>
  const list = document.getElementById('work-list');
  const preview = document.getElementById('hover-preview');
  const previewImg = document.getElementById('hover-preview-img') as HTMLImageElement | null;

  if (list && preview && previewImg && window.matchMedia('(hover: hover)').matches) {
    // A transformed ancestor (the scroll-reveal wrapper) would make position:fixed
    // resolve against that element instead of the viewport, so move it to the body.
    document.body.appendChild(preview);

    let raf = 0;
    let pointerX = 0;
    let pointerY = 0;

    const position = () => {
      const { width, height } = preview.getBoundingClientRect();
      const margin = 16;
      // Keep the preview fully on screen rather than letting it run off an edge
      const half = { w: width / 2, h: height / 2 };
      const x = Math.min(
        Math.max(pointerX, half.w + margin),
        window.innerWidth - half.w - margin
      );
      const y = Math.min(
        Math.max(pointerY, half.h + margin),
        window.innerHeight - half.h - margin
      );
      preview.style.transform = `translate(${x - half.w}px, ${y - half.h}px)`;
      raf = 0;
    };

    list.addEventListener('mousemove', (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!raf) raf = requestAnimationFrame(position);
    });

    list.querySelectorAll<HTMLAnchorElement>('.work-row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        const src = row.dataset.image;
        if (src && previewImg.src !== src) previewImg.src = src;
        preview.style.opacity = '1';
      });
      row.addEventListener('mouseleave', () => {
        preview.style.opacity = '0';
      });
    });

    // Never leave it hanging if the pointer leaves the list or the page scrolls away
    list.addEventListener('mouseleave', () => {
      preview.style.opacity = '0';
    });
    window.addEventListener('scroll', () => {
      preview.style.opacity = '0';
    });
  }
</script>
