---
import { getCollection } from 'astro:content';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => b.data.order - a.data.order
);
---

{
  testimonials.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="font-display text-3xl font-medium sm:text-4xl" data-reveal>
          What clients say
        </h2>

        <div class="stagger mt-12 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-3">
          {testimonials.map((item) => (
            <figure class="border-t border-line pt-6" data-reveal>
              <blockquote class="font-display text-xl leading-snug italic text-ink">
                “{item.data.quote}”
              </blockquote>
              <figcaption class="mt-5 text-sm text-ink-soft">
                <span class="font-medium text-ink">{item.data.name}</span>
                {' — '}
                {item.data.role}
                {item.data.company && `, ${item.data.company}`}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
