---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = featured.length > 0 ? featured : allWork.slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-12 sm:gap-6">
      <p class="text-sm font-medium text-ink-soft sm:col-span-3">
        <span class="text-2xl">👋</span><br />
        Kuzu Zangpo La — Product Designer based in Thimphu, Bhutan.
      </p>
      <h1 class="font-display sm:col-span-9 text-4xl leading-[1.05] font-medium sm:text-6xl md:text-7xl">
        I design digital products that are <em class="text-accent not-italic">clear</em>,
        usable, and built to <em class="font-display italic">scale.</em>
      </h1>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 border-t border-line/70 pt-8 sm:grid-cols-12">
      <p class="text-lg text-ink-soft sm:col-span-6">
        I'm Sujan Mongar — a product designer working across UX audits, research, and
        high-fidelity UI for web and mobile. Available for freelance work and collaborations
        worldwide.
      </p>
      <div class="flex flex-wrap items-start gap-4 sm:col-span-6 sm:justify-end">
        <a
          href="#selected-work"
          class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent"
        >
          View work
        </a>
        <a
          href="#get-in-touch"
          class="rounded-full border border-ink/15 px-6 py-3 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <section id="selected-work" data-reveal class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="flex items-end justify-between">
      <p class="font-display text-sm font-medium text-ink-soft italic">Selected work</p>
      <a href="/work/" class="text-sm font-semibold text-ink-soft transition-colors hover:text-accent">
        View all works →
      </a>
    </div>
    <div class="mt-8">
      <WorkList projects={projects} />
    </div>
  </section>
</BaseLayout>
