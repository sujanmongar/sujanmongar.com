---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = work.filter((p) => p.data.featured);
const projects = (featured.length > 0 ? featured : work).slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <Hero />

  <section id="selected-work" class="section">
    <div class="wrap pb-14 sm:pb-16">
      <h2 class="font-display text-3xl font-medium sm:text-4xl">Work I'm proud of</h2>
    </div>

    <div class="space-y-24 sm:space-y-32">
      {projects.map((project, i) => <ProjectCard project={project} index={i} priority={i === 0} />)}
    </div>

    <div class="wrap mt-20 flex justify-center sm:mt-24">
      <a
        href="/work/"
        class="group inline-flex items-center gap-2 rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
      >
        View all works
        <span
          aria-hidden="true"
          class="text-lg transition-transform duration-300 group-hover:translate-x-1.5"
        >
          →
        </span>
      </a>
    </div>
  </section>

  <Process />
</BaseLayout>
