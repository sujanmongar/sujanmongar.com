---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = featured.length > 0 ? featured : allWork.slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
    <p class="text-2xl">👋</p>
    <h1 class="mt-6 max-w-3xl text-4xl font-extrabold sm:text-5xl md:text-6xl">
      Kuzu Zangpo La, I'm Sujan Mongar, Product Designer crafting digital experiences that people
      love to use.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-soft">
      Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products
      through UX audits, research, and high-fidelity UI — available for freelance work and
      collaborations worldwide.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="#selected-work"
        class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent"
      >
        View work
      </a>
      <a
        href="#get-in-touch"
        class="rounded-full border border-ink/15 px-6 py-3 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section id="selected-work" class="mx-auto max-w-5xl px-6 py-16">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold sm:text-3xl">Work I'm proud of</h2>
      <a href="/work/" class="text-sm font-semibold text-ink-soft hover:text-accent">
        View all works →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {projects.map((project, i) => <ProjectCard project={project} priority={i === 0} />)}
    </div>
  </section>
</BaseLayout>
