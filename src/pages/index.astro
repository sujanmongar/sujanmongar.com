---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = work.filter((p) => p.data.featured);
const projects = (featured.length > 0 ? featured : work).slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <Hero />

  <section id="selected-work" class="section">
    <div class="wrap pb-14 sm:pb-16">
      <h2 class="font-display text-3xl font-medium sm:text-4xl">Work I'm proud of</h2>
    </div>

    {/* The first project runs full-width as the lead story; the rest sit in
        a tighter grid below, so adding a 3rd or 4th project doesn't just
        make the homepage longer and longer. */}
    <ProjectCard project={projects[0]} index={0} priority size="feature" />

    {
      projects.length > 1 &&
        (() => {
          const secondary = projects.slice(1);
          // An odd count leaves a trailing entry with no partner — give it
          // the full row instead of leaving an empty cell beside it.
          const lastWideIndex = secondary.length % 2 === 1 ? secondary.length - 1 : -1;
          return (
            <div class="wrap mt-20 grid grid-cols-1 gap-x-12 gap-y-16 sm:mt-24 sm:grid-cols-2">
              {secondary.map((project, i) => (
                <ProjectCard
                  project={project}
                  index={i + 1}
                  size="compact"
                  wide={i === lastWideIndex}
                />
              ))}
            </div>
          );
        })()
    }

    <div class="wrap mt-20 flex justify-center sm:mt-24">
      <a
        href="/work/"
        class="group inline-flex items-center gap-2 rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
      >
        View all works
        <span
          aria-hidden="true"
          class="text-lg transition-transform duration-300 group-hover:translate-x-1.5"
        >
          →
        </span>
      </a>
    </div>
  </section>

  <Process />
</BaseLayout>
