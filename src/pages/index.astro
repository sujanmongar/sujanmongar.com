---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkList from '../components/WorkList.astro';
import Process from '../components/Process.astro';
import SectionKicker from '../components/SectionKicker.astro';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = featured.length > 0 ? featured : allWork.slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <Hero />

  <section id="selected-work" data-reveal class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="flex items-end justify-between">
      <SectionKicker label="Selected work" />
      <a href="/work/" class="text-sm font-semibold text-ink-soft transition-colors hover:text-accent">
        View all works →
      </a>
    </div>
    <div class="mt-8">
      <WorkList projects={projects} />
    </div>
  </section>

  <Process />
</BaseLayout>
