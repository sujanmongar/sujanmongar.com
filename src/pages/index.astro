---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = work.filter((p) => p.data.featured);
const projects = (featured.length > 0 ? featured : work).slice(0, 4);
---

<BaseLayout
  title="Sujan Mongar — Product Designer (UX/UI)"
  description="Bhutanese Product Designer (UX/UI) designing clear, usable, and scalable digital products through UX audits, research, and high-fidelity UI — available for freelance work and collaborations worldwide."
>
  <Hero />

  <section id="selected-work" class="section">
    <div class="wrap flex items-baseline justify-between gap-6 pb-14 sm:pb-16">
      <h2 class="font-display text-3xl font-medium sm:text-4xl">Selected work</h2>
      <a
        href="/work/"
        class="shrink-0 text-sm font-semibold text-ink-soft transition-colors hover:text-accent"
      >
        View all →
      </a>
    </div>

    <div class="space-y-24 sm:space-y-32">
      {projects.map((project, i) => <ProjectCard project={project} index={i} priority={i === 0} />)}
    </div>
  </section>

  <Process />
</BaseLayout>
