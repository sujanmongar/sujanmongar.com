---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/sujan.webp';

const experience = (await getCollection('experience')).sort((a, b) => b.data.order - a.data.order);

// Drawn from how Sujan describes his own practice, not invented
const capabilities = [
  {
    title: 'UX audits',
    body: 'Reviewing an existing product to find where structure, navigation, or trust break down.'
  },
  {
    title: 'User research',
    body: 'Understanding who the product is for and what actually gets in their way.'
  },
  {
    title: 'Usability testing',
    body: 'Putting flows in front of real people to check the design holds up before it ships.'
  },
  {
    title: 'Wireframing',
    body: 'Working out hierarchy and flow early, while changes are still cheap to make.'
  },
  {
    title: 'High-fidelity UI',
    body: 'Designing the finished interface as a system — components and states, not one screen.'
  },
  {
    title: 'Design systems',
    body: 'Keeping type, colour, and components consistent so a product can grow without drifting.'
  }
];

/* Copy below is taken verbatim from sujanmongar.com/about */
const facts = [
  { label: 'Focus', value: 'UX Flow, UI Systems, and Design Systems' },
  { label: 'Strengths', value: 'Clarity, Consistency, and Delivery' },
  { label: 'Available for', value: 'Full-time, Contract, and Freelance' }
];

const details = [
  { label: 'Based in', value: 'Thimphu, Bhutan' },
  { label: 'Email', value: 'sujanallaymongar506@gmail.com', href: 'mailto:sujanallaymongar506@gmail.com' },
  { label: 'Phone', value: '+61 451 716 040', href: 'tel:+61451716040' }
];

const description =
  'Sujan Mongar is a Bhutanese Product Designer (UX/UI) specialising in UX audits, research, usability testing, and high-fidelity UI for web and mobile products.';
---

<BaseLayout title="About" description={description}>
  {/* Profile structured data, so this page reads as the canonical page about Sujan */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: 'https://sujanmongar.com/about/',
      name: 'About Sujan Mongar',
      description,
      mainEntity: {
        '@type': 'Person',
        '@id': 'https://sujanmongar.com/#person',
        name: 'Sujan Mongar',
        jobTitle: 'Product Designer (UX/UI)',
        description,
        url: 'https://sujanmongar.com',
        email: 'mailto:sujanallaymongar506@gmail.com',
        telephone: '+61451716040',
        nationality: {
          '@type': 'Country',
          name: 'Bhutan'
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Thimphu',
          addressCountry: 'BT'
        },
        knowsAbout: capabilities.map((item) => item.title),
        sameAs: ['https://www.linkedin.com/in/sujanmongar/']
      }
    })}
  />

  <section class="wrap pt-12 pb-[clamp(3rem,7vw,5rem)] sm:pt-16">
    <p class="hero-in hero-in-1 text-sm tracking-[0.18em] text-ink-soft uppercase">About</p>
    <h1
      class="hero-in hero-in-2 font-display mt-6 text-[clamp(2.5rem,6.4vw,5.5rem)] leading-[1.04] font-medium tracking-[-0.02em] sm:mt-8"
    >
      Sujan Mongar,<br />
      <span class="text-ink-soft">Product Designer (UX/UI)</span>
    </h1>
  </section>

  {/* Portrait and the statement sit side by side on desktop, stacked on mobile */}
  <section class="wrap grid grid-cols-1 gap-10 pb-[clamp(3rem,7vw,5rem)] lg:grid-cols-12 lg:gap-16" data-reveal>
    <div class="lg:col-span-5">
      <Image
        src={portrait}
        alt="Sujan Mongar"
        width={1000}
        quality={92}
        loading="eager"
        class="aspect-[4/5] w-full rounded-2xl bg-paper-dim object-cover"
      />
    </div>

    <div class="lg:col-span-7 lg:pt-2">
      <p class="text-xl leading-relaxed sm:text-2xl sm:leading-[1.6]">
        I am a Bhutanese Product Designer (UX/UI) specialising in UX audits, user research,
        usability testing, wireframing, and high-fidelity UI design for web and mobile products.
      </p>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft">
        I work with startups, growing businesses, and teams to improve user experience, increase
        usability, and design scalable digital solutions. My approach is UX-first — focused on
        clarity, structure, and meaningful product outcomes. Available for UX/UI roles, freelance
        projects, and collaborations worldwide.
      </p>

      <dl class="mt-10 grid grid-cols-1 gap-x-10 gap-y-5 sm:grid-cols-2">
        {
          details.map((detail) => (
            <div>
              <dt class="text-xs tracking-[0.14em] text-ink-soft uppercase">{detail.label}</dt>
              <dd class="mt-1.5 font-medium break-words">
                {detail.href ? (
                  <a href={detail.href} class="transition-colors hover:text-accent">
                    {detail.value}
                  </a>
                ) : (
                  detail.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-accent"
        >
          Download resume
        </a>
        <a
          href="#get-in-touch"
          class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>

  {/* Facts read as one quiet panel rather than three bordered boxes */}
  <section class="wrap pb-[clamp(3rem,7vw,5rem)]" data-reveal>
    <dl class="grid grid-cols-1 gap-8 rounded-2xl bg-paper-dim p-8 sm:grid-cols-3 sm:gap-10 sm:p-10">
      {
        facts.map((fact) => (
          <div>
            <dt class="text-xs tracking-[0.14em] text-ink-soft uppercase">{fact.label}</dt>
            <dd class="mt-2.5 text-lg leading-snug font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="font-display text-3xl font-medium sm:text-4xl" data-reveal>What I do</h2>
      <div class="stagger mt-12 grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.map((item, i) => (
            <div class="border-t border-line pt-5" data-reveal>
              <span class="font-display text-2xl font-medium text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-xl font-medium">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    experience.length > 0 && (
      <section class="wrap pb-[clamp(4rem,9vw,7rem)]">
        <h2 class="font-display text-3xl font-medium sm:text-4xl" data-reveal>Experience</h2>
        <ol class="stagger mt-12 space-y-8">
          {experience.map((job) => (
            <li
              class="flex flex-col gap-1 border-b border-line pb-8 last:border-0 sm:flex-row sm:justify-between sm:gap-8"
              data-reveal
            >
              <div>
                <p class="text-xl font-medium">{job.data.role}</p>
                <p class="mt-1 text-ink-soft">
                  {job.data.link ? (
                    <a
                      href={job.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors hover:text-accent"
                    >
                      {job.data.company}
                    </a>
                  ) : (
                    job.data.company
                  )}
                  {job.data.location && ` · ${job.data.location}`}
                </p>
              </div>
              <p class="shrink-0 text-sm text-ink-soft sm:text-right">
                {job.data.startDate} — {job.data.endDate ?? 'Present'}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="wrap pb-[clamp(4rem,9vw,7rem)]" data-reveal>
    <p class="font-display text-[clamp(1.9rem,4.4vw,3.25rem)] leading-[1.15] font-medium tracking-[-0.01em]">
      Designing with purpose, <span class="text-accent">building with care.</span>
    </p>
    <a
      href="/work/"
      class="mt-8 inline-flex items-center gap-2 text-sm font-semibold transition-colors hover:text-accent"
    >
      See selected work
      <span aria-hidden="true" class="text-lg">→</span>
    </a>
  </section>
</BaseLayout>
