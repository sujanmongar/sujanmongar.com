---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-6 text-center">
    <p class="text-sm font-semibold tracking-[0.2em] text-ink-soft uppercase">404</p>
    <h1 class="font-display mt-4 text-3xl font-medium sm:text-4xl">This page doesn't exist.</h1>
    <p class="mt-4 text-ink-soft">
      The page you're looking for may have moved or been removed.
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
