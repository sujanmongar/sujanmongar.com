---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Work"
  description="UX/UI case studies by Sujan Mongar — research, audits, and high-fidelity design for web and mobile products."
>
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="text-sm font-medium text-ink-soft">Selected work</p>
    <h1 class="font-display mt-3 text-4xl font-medium italic sm:text-6xl">Work I'm proud of</h1>
    <p class="mt-6 max-w-lg text-lg text-ink-soft">
      Case studies from product design engagements — research, UX audits, and high-fidelity UI
      across web and mobile.
    </p>

    <div class="mt-14" data-reveal>
      <WorkList projects={work} />
    </div>
  </section>
</BaseLayout>
