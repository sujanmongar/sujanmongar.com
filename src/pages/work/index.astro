---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Filters come from the tags actually used, so they stay correct as work is added
const tagCounts = new Map<string, number>();
for (const project of work) {
  for (const tag of project.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const filters = [...tagCounts.entries()]
  .filter(([, count]) => count > 1 || work.length < 4)
  .map(([tag]) => tag)
  .sort();
---

<BaseLayout
  title="Work"
  description="UX/UI case studies by Sujan Mongar — research, audits, and high-fidelity design for web and mobile products."
>
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="text-sm font-medium tracking-[0.15em] text-ink-soft uppercase">Selected work</p>
    <h1 class="font-display mt-4 text-4xl font-medium italic sm:text-6xl">Work I'm proud of</h1>
    <p class="mt-6 max-w-lg text-ink-soft">
      Case studies from product design engagements — research, UX audits, and high-fidelity UI
      across web and mobile.
    </p>

    {
      filters.length > 1 && (
        <div class="mt-10 flex flex-wrap gap-2" id="work-filters">
          <button
            type="button"
            data-filter="all"
            class="filter-chip rounded-full border border-ink px-4 py-2 text-sm font-semibold transition-colors"
            aria-pressed="true"
          >
            All work
          </button>
          {filters.map((tag) => (
            <button
              type="button"
              data-filter={tag}
              class="filter-chip rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold text-ink-soft transition-colors hover:border-ink/40"
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
        </div>
      )
    }

    <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2" id="work-grid">
      {
        work.map((project) => (
          <a
            href={`/work/${project.id}/`}
            class="work-card group block"
            data-tags={project.data.tags.join('|')}
          >
            <div class="overflow-hidden rounded-lg bg-paper-dim">
              <Image
                src={project.data.cover}
                alt={project.data.coverAlt}
                width={1000}
                quality={92}
                loading="lazy"
                class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <h2 class="font-display mt-6 text-2xl font-medium italic transition-colors group-hover:text-accent sm:text-3xl">
              {project.data.title}
            </h2>
            <p class="mt-3 text-ink-soft">{project.data.summary}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-soft">
              <span>{project.data.role}</span>
              <span aria-hidden="true">·</span>
              <span>{project.data.timeline}</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-12 hidden text-ink-soft" id="work-empty">
      Nothing in that category yet.
    </p>
  </section>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.work-card');
  const empty = document.getElementById('work-empty');

  const active = ['border-ink', 'text-ink'];
  const idle = ['border-ink/15', 'text-ink-soft', 'hover:border-ink/40'];

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? 'all';

      chips.forEach((other) => {
        const on = other === chip;
        other.setAttribute('aria-pressed', String(on));
        other.classList.remove(...(on ? idle : active));
        other.classList.add(...(on ? active : idle));
      });

      let shown = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split('|');
        const match = filter === 'all' || tags.includes(filter);
        card.hidden = !match;
        if (match) shown += 1;
      });

      empty?.classList.toggle('hidden', shown > 0);
    });
  });
</script>
