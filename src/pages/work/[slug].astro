---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, cover, coverAlt, role, timeline, deliverables, client, link, figma, tags } =
  entry.data;

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allWork.findIndex((p) => p.id === entry.id);
const prevProject = currentIndex > 0 ? allWork[currentIndex - 1] : null;
const nextProject = currentIndex < allWork.length - 1 ? allWork[currentIndex + 1] : null;
---

<BaseLayout title={title} description={summary} image={cover.src} type="article">
  {/* Case study structured data, so search engines can read this as a work
      sample with a clear author, subject and imagery */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: title,
      headline: title,
      description: summary,
      image: new URL(cover.src, Astro.site).href,
      url: new URL(Astro.url.pathname, Astro.site).href,
      keywords: tags.join(', '),
      inLanguage: 'en',
      author: {
        '@type': 'Person',
        name: 'Sujan Mongar',
        jobTitle: 'Product Designer (UX/UI)',
        url: 'https://sujanmongar.com'
      },
      creator: { '@type': 'Person', name: 'Sujan Mongar' },
      about: deliverables.join(', '),
      ...(client ? { sourceOrganization: { '@type': 'Organization', name: client } } : {})
    })}
  />

  <nav aria-label="Breadcrumb" class="sr-only">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/work/">Work</a></li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sujanmongar.com/' },
        { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://sujanmongar.com/work/' },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: new URL(Astro.url.pathname, Astro.site).href
        }
      ]
    })}
  />
  <article>
    <header class="wrap pt-16 sm:pt-20">
      <a href="/work/" class="text-sm font-semibold text-ink-soft transition-colors hover:text-accent">
        ← All work
      </a>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-semibold text-ink-soft uppercase tracking-wide">
              {tag}
            </li>
          ))
        }
      </ul>
      <h1 class="font-display mt-6 text-4xl leading-[1.05] font-medium sm:text-6xl">
        {title}
      </h1>

      {/* No summary paragraph here — the content's own "Overview" section
          says the same thing in more depth right below. `summary` still
          drives the meta description and structured data. */}
      <dl class="mt-8 grid grid-cols-2 gap-6 border-y border-line/70 py-8 sm:grid-cols-4">
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Role</dt>
          <dd class="mt-1 font-medium">{role}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Timeline</dt>
          <dd class="mt-1 font-medium">{timeline}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Deliverables</dt>
          <dd class="mt-1 font-medium">{deliverables.join(', ')}</dd>
        </div>
        {
          client && (
            <div>
              <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Client</dt>
              <dd class="mt-1 font-medium">{client}</dd>
            </div>
          )
        }
      </dl>

      {
        (link || figma) && (
          <div class="mt-6 flex flex-wrap gap-4">
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-accent"
              >
                View live site ↗
              </a>
            )}
            {figma && (
              <a
                href={figma}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
              >
                View Figma prototype ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="prose-case wrap py-16 sm:py-20">
      <Content />
    </div>
  </article>

  {
    prevProject && nextProject && (
      <nav class="border-t border-line/70 bg-paper" aria-label="More projects">
        {/* Two columns, prev on the left and next mirrored to the right */}
        <div class="wrap grid grid-cols-1 gap-10 pt-12 pb-16 sm:grid-cols-2 sm:pt-14 sm:pb-20">
          <a href={`/work/${prevProject.id}/`} class="group flex items-center gap-6 sm:col-start-1">
            <div class="w-32 shrink-0 overflow-hidden rounded-lg sm:w-44">
              <Image
                src={prevProject.data.cover}
                alt={prevProject.data.coverAlt}
                width={500}
                quality={92}
                loading="lazy"
                class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold tracking-wide text-ink-soft uppercase">
                ← Previous project
              </p>
              <h2 class="font-display mt-2 text-2xl font-medium transition-colors group-hover:text-accent sm:text-3xl">
                {prevProject.data.title}
              </h2>
            </div>
          </a>

          <a
            href={`/work/${nextProject.id}/`}
            class="group flex items-center gap-6 sm:col-start-2 sm:flex-row-reverse sm:text-right"
          >
            <div class="w-32 shrink-0 overflow-hidden rounded-lg sm:w-44">
              <Image
                src={nextProject.data.cover}
                alt={nextProject.data.coverAlt}
                width={500}
                quality={92}
                loading="lazy"
                class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold tracking-wide text-ink-soft uppercase">
                Next project →
              </p>
              <h2 class="font-display mt-2 text-2xl font-medium transition-colors group-hover:text-accent sm:text-3xl">
                {nextProject.data.title}
              </h2>
            </div>
          </a>
        </div>
      </nav>
    )
  }

  {
    /* Only one direction to go (first or last project) — a single centered,
       larger block reads better than a small block pinned to one side of a
       mostly-empty row. */
    (prevProject || nextProject) &&
      !(prevProject && nextProject) &&
      (() => {
        const solo = prevProject ?? nextProject!;
        const label = prevProject ? '← Previous project' : 'Next project →';
        return (
          <nav class="border-t border-line/70 bg-paper" aria-label="More projects">
            {/* Image and text keep the same left-to-right reading order and
                left-aligned text as the paired layout — only the whole
                block is centered on the page, not the text within it. */}
            <div class="wrap flex justify-center py-16 sm:py-20">
              <a href={`/work/${solo.id}/`} class="group flex items-center gap-6 sm:gap-8">
                <div class="w-32 shrink-0 overflow-hidden rounded-lg sm:w-48">
                  <Image
                    src={solo.data.cover}
                    alt={solo.data.coverAlt}
                    width={700}
                    quality={92}
                    loading="lazy"
                    class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold tracking-wide text-ink-soft uppercase">
                    {label}
                  </p>
                  <h2 class="font-display mt-2 text-2xl font-medium transition-colors group-hover:text-accent sm:text-4xl">
                    {solo.data.title}
                  </h2>
                </div>
              </a>
            </div>
          </nav>
        );
      })()
  }
</BaseLayout>
