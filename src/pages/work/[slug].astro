---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, cover, coverAlt, role, timeline, deliverables, client, link, figma, tags } =
  entry.data;

const allWork = await getCollection('work', ({ data }) => !data.draft);
const otherProjects = allWork.filter((p) => p.id !== entry.id).slice(0, 2);
---

<BaseLayout title={title} description={summary} image={cover.src} type="article">
  <article>
    <header class="mx-auto max-w-3xl px-6 pt-16">
      <ul class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li class="rounded-full bg-paper-dim px-3 py-1 text-xs font-semibold text-ink-soft uppercase tracking-wide">
              {tag}
            </li>
          ))
        }
      </ul>
      <h1 class="mt-6 text-4xl font-extrabold sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-ink-soft">{summary}</p>

      <dl class="mt-10 grid grid-cols-2 gap-6 border-y border-line/70 py-8 sm:grid-cols-4">
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Role</dt>
          <dd class="mt-1 font-medium">{role}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Timeline</dt>
          <dd class="mt-1 font-medium">{timeline}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Deliverables</dt>
          <dd class="mt-1 font-medium">{deliverables.join(', ')}</dd>
        </div>
        {
          client && (
            <div>
              <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Client</dt>
              <dd class="mt-1 font-medium">{client}</dd>
            </div>
          )
        }
      </dl>

      {
        (link || figma) && (
          <div class="mt-6 flex flex-wrap gap-4">
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-accent"
              >
                View live site ↗
              </a>
            )}
            {figma && (
              <a
                href={figma}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
              >
                View Figma prototype ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="mx-auto mt-12 max-w-3xl px-6">
      <Image
        src={cover}
        alt={coverAlt}
        width={1400}
        height={900}
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-2xl border border-line/70 object-cover"
      />
    </div>

    <div class="prose-case mx-auto max-w-3xl px-6 py-16">
      <Content />
    </div>
  </article>

  {
    otherProjects.length > 0 && (
      <section class="border-t border-line/70 bg-paper-dim py-20">
        <div class="mx-auto max-w-5xl px-6">
          <h2 class="text-2xl font-bold">More projects</h2>
          <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
            {otherProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
