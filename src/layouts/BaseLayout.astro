---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} />
    {/* [data-reveal] content is only ever made visible by the reveal script
        below — if JS is blocked or fails, this keeps it from staying
        invisible forever. */}
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        '@id': 'https://sujanmongar.com/#person',
        name: 'Sujan Mongar',
        jobTitle: 'Product Designer (UX/UI)',
        description:
          'Bhutanese Product Designer (UX/UI) specialising in UX audits, user research, usability testing, wireframing, and high-fidelity UI design for web and mobile products.',
        url: 'https://sujanmongar.com',
        email: 'mailto:sujanallaymongar506@gmail.com',
        nationality: {
          '@type': 'Country',
          name: 'Bhutan'
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Thimphu',
          addressCountry: 'BT'
        },
        knowsAbout: [
          'UX Design',
          'UI Design',
          'Product Design',
          'UX Research',
          'Usability Testing',
          'Wireframing',
          'Design Systems',
          'Prototyping'
        ],
        knowsLanguage: ['en'],
        sameAs: ['https://www.linkedin.com/in/sujanmongar/']
      })}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[100] focus-visible:rounded-full focus-visible:bg-ink focus-visible:px-5 focus-visible:py-2.5 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-paper"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* Persistent contact CTA, freed from the header — fades out once the
        real contact section (footer) comes into view so it never overlaps it.
        A compact icon on mobile so it never sits over nearby links; the full
        labelled pill once there is room for it. */}
    <a
      href="#get-in-touch"
      id="floating-contact"
      aria-label="Get in touch"
      class="fixed right-4 bottom-4 z-40 inline-flex size-12 items-center justify-center gap-2 rounded-full bg-ink text-paper shadow-lg shadow-ink/20 transition-all duration-300 hover:bg-accent sm:right-6 sm:bottom-6 sm:size-auto sm:px-5 sm:py-3"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 sm:hidden"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
      </svg>
      <span class="hidden text-sm font-semibold sm:inline">Get in touch</span>
    </a>

    <script>
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

      const floatingContact = document.getElementById('floating-contact');
      const contactSection = document.getElementById('get-in-touch');

      if (floatingContact && contactSection) {
        const contactObserver = new IntersectionObserver(
          ([entry]) => {
            floatingContact.classList.toggle('opacity-0', entry.isIntersecting);
            floatingContact.classList.toggle('pointer-events-none', entry.isIntersecting);
          },
          { threshold: 0.1 }
        );
        contactObserver.observe(contactSection);
      }
    </script>
  </body>
</html>
